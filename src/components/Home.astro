---
import ClampedContainer from "./ClampedContainer.astro";
import SocialLinks from "./SocialLinks.astro";
import Tooltip from "./home/Tooltip.svelte";
import StarlingLogo from "../assets/starling-bank.svg";
import { Image } from "astro:assets";
---

<main class="w-screen flex flex-col items-center">
  <nav
    class="grid grid-cols-[1fr_auto_1fr] h-[90px] w-full px-12 py-4 max-w-[1440px] mx-auto
    max-sm:px-6 max-sm:opacity-0"
  >
    <div class="flex flex-col items-start justify-center">
      <span>Haydon Lam</span>
      <small class="text-muted-foreground text-sm"
        >London, United Kingdom, <slot />
      </small>
    </div>
    <menu
      class="flex items-center gap-4 px-4 pb-[8px] pt-[13px] bg-white/20 rounded-full justify-self-auto"
    >
      WIP 🚧
      <!-- <span>Photos</span>
      <span>London</span>
      <span>London</span>
      <span>London</span> -->
    </menu>
    <div class="flex items-end flex-col justify-center">
      <small class="text-muted-foreground text-sm">Socials</small>
      <div class="flex gap-2">
        <SocialLinks />
      </div>
    </div>
  </nav>
  <section class="h-[768px] max-sm:h-[500px] w-full grid place-items-center">
    <ClampedContainer>
      <div
        class="relative flex flex-col items-center justify-center translate-y-[-45px]
        max-sm:items-start"
      >
        <p class="text-muted-foreground self-start">Welcome, I&apos;m Haydon</p>
        <h1 class="text-center max-sm:hidden">Fullstack Software Engineer</h1>
        <h1 class="text-center max-sm:hidden">currently based in London.</h1>
        <h1 class="min-sm:hidden">
          Fullstack Software Engineer currently based in London.
        </h1>
      </div>
    </ClampedContainer>
  </section>
  <section class="bg-muted-background w-full">
    <ClampedContainer>
      <h2 class="mb-3" id="more-about-me">More about me</h2>
      <div class="max-w-2xl text-xl max-lg:max-w-full">
        <p>
          Outside of my professional life as a <span
            id="software-engineer-tooltip"
            class="underline cursor-help underline-offset-4 decoration-dashed"
            >software engineer</span
          >, I spend a lot of time <span
            id="lifting-weights-tooltip"
            class="underline cursor-help underline-offset-4 decoration-dashed"
            >lifting weights</span
          >, recently started <span
            id="running-tooltip"
            class="underline cursor-help underline-offset-4 decoration-dashed"
            >running</span
          >, and try bouldering every now and then.
        </p>
        <br />
        <p>
          I&apos;ve also gotten into wood carving as a creative endeavour—and as
          a bonus, it cuts down my screen time, even if just a little. I enjoy
          photography too, especially when I&apos;m travelling.
        </p>
        <br />
        <p>
          According to 16Personalities, I&apos;m a <a
            href="https://www.16personalities.com/istj-personality"
            target="_blank"
            rel="noopener noreferer"
          >
            Logistician (ISTJ)</a
          >
          , which honestly feels pretty accurate.
        </p>
      </div>
      <Tooltip linkedElId="software-engineer-tooltip" client:idle>
        <p class="flex flex-col gap-2">
          <small>Currently working at</small>
          <span class="flex items-center gap-2">
            Starling Bank
            <Image width={24} src={StarlingLogo} alt="Starling Bank Logo" />
          </span>
        </p>
      </Tooltip>
      <Tooltip linkedElId="lifting-weights-tooltip" client:idle>
        <p>
          <small>Current goals</small>
        </p>
        <p>Bench Press: 110kg</p>
        <p>Weighted Pull-ups: 30kg</p>
      </Tooltip>
      <Tooltip linkedElId="running-tooltip" client:idle>
        <p>
          <small>Current goals</small>
        </p>
        <p>Run 10K</p>
      </Tooltip>
    </ClampedContainer>
  </section>
  <section class="w-full">
    <ClampedContainer>
      <h2 class="mb-3">Discover</h2>
      <ul class="flex flex-col gap-3">
        <li><h4 class="">Github Projects</h4></li>
        <li><h4 class=""><a href="/photos">Photography</a></h4></li>
        <li><h4 class="">Lab/ Experiments</h4></li>
        <li><h4 class="">Spoon Carving</h4></li>
      </ul>
    </ClampedContainer>
  </section>
  <footer class="bg-muted-background w-full pb-12">
    <ClampedContainer>
      <h3>Socials</h3>
      <div class="flex gap-2">
        <SocialLinks />
      </div>
      <p class="text-center mt-3">Made with ❤️ by me!</p>
    </ClampedContainer>
  </footer>
</main>
