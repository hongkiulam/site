---
import Layout from '../../layouts/Layout.astro';
import R3FPhantomLandComponent from '../../components/experiments/R3FPhantomLandClone';
---

<Layout title="R3F Phantom Land Clone">
  <main>
    <div class="infinite-grid-container">
      <R3FPhantomLandComponent client:load />
    </div>
  </main>
</Layout>

<style>
  .infinite-grid-container {
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
</style>
