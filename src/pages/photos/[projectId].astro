---
import Layout from '@layouts/Layout.astro';
import BorderedContainedSection from '@components/_shared/BorderedContainedSection.astro';
import MobileNav from '@components/MobileNav';
import Image from '@components/photos/Image.svelte';

import { GET } from '../../pages/api/behance/all-graphql';
import type { SanitisedBehancePhotographyProject } from '@@types/behance';

export const prerender = true;
export async function getStaticPaths() {
  const allProjectsResponse = await GET(Astro);
  const allProjects: SanitisedBehancePhotographyProject[] = await allProjectsResponse.json();
  return allProjects.map((project) => ({
    params: { projectId: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<Layout title={project.name}>
  <main class="w-full min-h-dvh flex flex-col items-center text-muted-foreground">
    <BorderedContainedSection condensed>
      <div class="flex flex-row justify-between">
        <a
          href="/"
          class="flex flex-col items-start justify-center max-sm:opacity-0 group no-underline"
          aria-label="Return to homepage"
        >
          <span>Haydon Lam</span>
        </a>
        <MobileNav client:load />
      </div>
    </BorderedContainedSection>
    <BorderedContainedSection>
      <h1>{project.name}</h1>
      <a href="/photos">Back to albums</a>
    </BorderedContainedSection>
    <BorderedContainedSection>
      <div class="grid grid-cols-2 gap-12 max-sm:grid-cols-1 max-sm:gap-8">
        {
          project.imageSizes.map((img, i) => {
            return <Image client:load imageSizes={img} index={i} />;
          })
        }
      </div>
    </BorderedContainedSection>
  </main>
</Layout>
