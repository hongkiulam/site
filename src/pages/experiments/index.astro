---
import ExperimentPageLayout from '@layouts/ExperimentPageLayout.astro';

const pages: { url: string }[] = Object.values(import.meta.glob('./*.astro', { eager: true }));
---

<ExperimentPageLayout>
  <ul class="flex p-2 flex-wrap gap-2 justify-around">
    {
      pages.map((page) => {
        const labelFromUrl = page.url.replace('/experiments/', '');
        return (
          <li>
            <a href={page.url}>{labelFromUrl}</a>
          </li>
        );
      })
    }
  </ul>
</ExperimentPageLayout>
