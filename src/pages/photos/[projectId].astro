---
import Layout from '@layouts/Layout.astro';
import Header from '@components/_shared/Header.astro';
import HeaderSpacer from '@components/_shared/HeaderSpacer.astro';

import PhotosScene from '@components/photos/PhotosScene';
import { GET } from '../../pages/api/behance/all-graphql';
import type { SanitisedBehancePhotographyProject } from '@@types/behance';
import HeaderBackdrop from '@components/_shared/HeaderBackdrop.astro';

export const prerender = true;
export async function getStaticPaths() {
  const allProjectsResponse = await GET(Astro);
  const allProjects: SanitisedBehancePhotographyProject[] = await allProjectsResponse.json();
  return allProjects.map((project) => ({
    params: { projectId: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<Layout>
  <main class="w-full h-full flex flex-col items-center bg-muted-background text-muted-foreground">
    <Header>
      <a href="/photos" class="">
        <h2>Back to albums</h2>
      </a>
    </Header>
    <HeaderBackdrop class="bg-gradient-to-b from-muted-background opacity-80" />

    <section class="h-full w-full relative flex items-center justify-center">
      <h2>Loading images...</h2>
      <div class="absolute w-full h-full">
        <PhotosScene client:load project={project} />
      </div>
    </section>
  </main>
</Layout>
