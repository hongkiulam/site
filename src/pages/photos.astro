---
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import Header from '@components/_shared/Header.astro';
import HeaderSpacer from '@components/_shared/HeaderSpacer.astro';
import HorizontalScrollExample from '@components/photos/HorizontalScrollExample';
import { GET } from '../pages/api/behance/all-graphql';
import type { SanitisedBehancePhotographyProject } from '@@types/behance';
import ProjectSelector from '@components/photos/ProjectSelector.svelte';

const allProjectsResponse = await GET(Astro);
const allProjects: SanitisedBehancePhotographyProject[] = await allProjectsResponse.json();
const firstProjectSlug = allProjects[0]?.slug || '';
---

<Layout>
  <astro-data data-first-project-slug={firstProjectSlug}></astro-data>
  <main class="w-full h-full flex flex-col items-center bg-muted-background">
    <Header />
    <HeaderSpacer />
    <ProjectSelector client:load allProjects={allProjects} />
    <section class="h-full w-full grid place-items-center">
      <!-- <PhotosScene client:load /> -->
      <HorizontalScrollExample client:load allProjects={allProjects} />
    </section>
  </main>
</Layout>

<script>
  import { projectSlugState } from '@components/photos/state/photos-state';
  const firstProjectSlug = (
    document.querySelector('astro-data[data-first-project-slug]') as HTMLElement
  ).dataset.firstProjectSlug!;
  const projectFromParam = new URLSearchParams(window.location.search).get('project');

  projectSlugState.set(projectFromParam || firstProjectSlug);
</script>
