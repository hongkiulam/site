---
import ExperimentPageLayout from '@layouts/ExperimentPageLayout.astro';

// Coordinate system: origin at top-centre of spoon
//   x: horizontal offset from centre (negative = left, positive = right)
//   y: vertical distance from top (positive = down)
//
//  -0,0 ——— 0,0  ← bowlTopLeft / bowlTopRight (spread apart for a square top)
//        /    \
// -60,50        60,50  ← bowlMiddle
//        \    /
//    -20,100  20,100  ← bowlBase
//       |        |
//   -11,113  11,113  ← handleMiddle
//       |        |
//    -9,212    9,212  ← handleBottom
//          \/
//       (rounded tip)

const SVG_ORIGIN = { x: 150, y: 50 };

const bowlTopLeft  = { x: 0, y: 0 };
const bowlTopRight = { x: 0, y: 0 };

const bowlMiddleRight = { x: 60, y: 50 };
const bowlMiddleLeft  = { x: -60, y: 50 };

const bowlBaseRight = { x: 20, y: 100 };
const bowlBaseLeft  = { x: -20, y: 100 };

const handleMiddleRight = { x: 11, y: 113 };
const handleMiddleLeft  = { x: -11, y: 113 };

const handleBottomRight = { x: 9, y: 212 };
const handleBottomLeft  = { x: -9, y: 212 };

// Convert a param-space point to an SVG coordinate string "x y"
function s({ x, y }: { x: number; y: number }) {
  return `${SVG_ORIGIN.x + x} ${SVG_ORIGIN.y + y}`;
}

// Cubic bezier segment helper
function C(
  cp1: { x: number; y: number },
  cp2: { x: number; y: number },
  end: { x: number; y: number },
) {
  return `C ${s(cp1)} ${s(cp2)} ${s(end)}`;
}

const bTL = bowlTopLeft;
const bTR = bowlTopRight;
const bMR = bowlMiddleRight;
const bML = bowlMiddleLeft;
const bBR = bowlBaseRight;
const bBL = bowlBaseLeft;
const hMR = handleMiddleRight;
const hML = handleMiddleLeft;
const hBR = handleBottomRight;
const hBL = handleBottomLeft;

// Control points are derived from the named anchors so the curve shape
// scales naturally when you adjust the anchor values.
const spoonPath = [
  `M ${s(bTL)}`,
  // flat top edge (zero-length when bTL === bTR, becomes a flat line when spread apart)
  `L ${s(bTR)}`,
  // right side of bowl — top to widest point
  C({ x: bMR.x * 0.75,                         y: bTR.y                         },
     { x: bMR.x,                                y: bMR.y * 0.6                   }, bMR),
  // right side of bowl — widest point to base
  C({ x: bMR.x,                                 y: bMR.y + (bBR.y - bMR.y) * 0.5 },
     { x: bBR.x + (bMR.x - bBR.x) * 0.625,    y: bBR.y - 5                     }, bBR),
  // right side — bowl base to handle middle
  C({ x: bBR.x - 5,                             y: bBR.y + 2                     },
     { x: hMR.x + 1,                            y: hMR.y - 6                     }, hMR),
  // right side of handle (straight)
  `L ${s(hBR)}`,
  // rounded handle tip
  C({ x: hBR.x,                                 y: hBR.y + 8                     },
     { x: hBL.x,                                y: hBL.y + 8                     }, hBL),
  // left side of handle (straight)
  `L ${s(hML)}`,
  // left side — handle middle to bowl base
  C({ x: hML.x - 1,                             y: hML.y - 6                     },
     { x: bBL.x + 5,                            y: bBL.y + 2                     }, bBL),
  // left side of bowl — base to widest point
  C({ x: bBL.x + (bML.x - bBL.x) * 0.625,     y: bBL.y - 5                     },
     { x: bML.x,                                y: bML.y + (bBL.y - bML.y) * 0.5 }, bML),
  // left side of bowl — widest point back to top
  C({ x: bML.x,                                 y: bML.y * 0.6                   },
     { x: bML.x * 0.75,                         y: bTL.y                         }, bTL),
  'Z',
].join('\n             ');
---

<ExperimentPageLayout>
  <section class="w-full flex flex-col items-center p-8">
    <h2 class="mb-8">Spoon Template SVG Generator</h2>
    <div class="flex items-center justify-center flex-1 w-full">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="300"
        height="300"
        viewBox="0 0 300 300"
      >
        <defs>
          <linearGradient id="spoon-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#aaa" />
            <stop offset="35%" style="stop-color:#eee" />
            <stop offset="65%" style="stop-color:#ccc" />
            <stop offset="100%" style="stop-color:#999" />
          </linearGradient>
        </defs>
        <path
          d={spoonPath}
          fill="url(#spoon-gradient)"
          stroke="#888"
          stroke-width="1"
        />
      </svg>
    </div>
  </section>
</ExperimentPageLayout>
