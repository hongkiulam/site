---
import SocialLinks from './SocialLinks.astro';
import { Image } from 'astro:assets';
import MobileNav from '@components/MobileNav.tsx';
import BorderedContainedSection from '@components/_shared/BorderedContainedSection.astro';
---

<main class="w-full flex flex-col items-center">
  <BorderedContainedSection condensed>
    <div class="flex flex-row justify-between">
      <a
        href="/"
        class="flex flex-col items-start justify-center max-sm:opacity-0 group no-underline"
        aria-label="Return to homepage"
      >
        <span>Haydon Lam</span>
        <!-- <div class="relative text-sm text-muted-foreground">
        <small class="overflow-hidden inline-block">London, United Kingdom </small>
      </div> -->
      </a>
      <MobileNav client:load />
    </div>
  </BorderedContainedSection>
  <!-- <Header>
    <a
      href="/"
      class="flex flex-col items-start justify-center max-sm:opacity-0 group no-underline"
      aria-label="Return to homepage"
    >
      <span>Haydon Lam</span>
      <div class="relative text-sm text-muted-foreground">
        <small class="overflow-hidden inline-block">London, United Kingdom </small>
      </div>
    </a>
  </Header> -->
  <!-- <HeaderSpacer /> -->
  <BorderedContainedSection>
    <div class="relative flex flex-col items-start justify-center py-6 max-sm:items-start">
      <p class="text-muted-foreground">Welcome, I&apos;m Haydon</p>
      <h1 class="text-center max-sm:hidden">Fullstack Software Engineer</h1>
      <h1 class="text-center max-sm:hidden">based in London.</h1>
      <h1 class="min-sm:hidden">Fullstack Software Engineer based in London.</h1>
    </div>
  </BorderedContainedSection>
  <!-- <section class="h-[768px] max-sm:h-[500px] w-full grid place-items-center">
    <div class="clamped">
      <div
        class="relative flex flex-col items-start justify-center translate-y-[-45px]
        max-sm:items-start"
      >
        <p class="text-muted-foreground">Welcome, I&apos;m Haydon</p>
        <h1 class="text-center max-sm:hidden">Fullstack Software Engineer</h1>
        <h1 class="text-center max-sm:hidden">based in London.</h1>
        <h1 class="min-sm:hidden">Fullstack Software Engineer based in London.</h1>
      </div>
    </div>
  </section> -->
  <BorderedContainedSection>
    <h2 class="mb-6" id="more-about-me">More about me</h2>
    <div class="border border-border">
      <!-- Software Engineering -->
      <div class="grid grid-cols-1 lg:grid-cols-2 border-b border-border last:border-b-0">
        <div class="p-6">
          <h4 class="mb-3">Software Engineering</h4>
          <p class="text-base">Currently working at Starling Bank.</p>
        </div>
        <div
          class="flex items-center justify-center bg-muted-background/50 lg:border-l border-border p-6"
        >
          <span class="text-8xl" role="img" aria-label="laptop">💻</span>
        </div>
      </div>

      <!-- Fitness -->
      <div class="grid grid-cols-1 lg:grid-cols-2 border-b border-border last:border-b-0">
        <div class="p-6">
          <h4 class="mb-3">Fitness</h4>
          <p class="text-base">
            Outside of my professional life as a software engineer, I spend a lot of time lifting
            weights, recently started running, and try bouldering every now and then.
          </p>
        </div>
        <div
          class="flex items-center justify-center bg-muted-background/50 lg:border-l border-border p-6"
        >
          <span class="text-8xl" role="img" aria-label="person lifting weights">🏋️</span>
        </div>
      </div>

      <!-- Wood Carving -->
      <div class="grid grid-cols-1 lg:grid-cols-2 border-b border-border last:border-b-0">
        <div class="p-6">
          <h4 class="mb-3">Wood Carving</h4>
          <p class="text-base">
            I've also gotten into wood carving as a creative endeavour—and as a bonus, it cuts down
            my screen time, even if just a little.
          </p>
        </div>
        <div
          class="flex items-center justify-center bg-muted-background/50 lg:border-l border-border p-6"
        >
          <span class="text-8xl" role="img" aria-label="wood">🪵</span>
        </div>
      </div>

      <!-- Photography -->
      <div class="grid grid-cols-1 lg:grid-cols-2 border-b border-border last:border-b-0">
        <div class="p-6">
          <h4 class="mb-3">Photography</h4>
          <p class="text-base">I enjoy photography too, especially when I'm travelling.</p>
        </div>
        <div
          class="flex items-center justify-center bg-muted-background/50 lg:border-l border-border p-6"
        >
          <span class="text-8xl" role="img" aria-label="camera">📷</span>
        </div>
      </div>

      <!-- Personality -->
      <div class="grid grid-cols-1 lg:grid-cols-2 border-b border-border last:border-b-0">
        <div class="p-6">
          <h4 class="mb-3">Personality</h4>
          <p class="text-base">
            According to 16Personalities, I'm a <a
              href="https://www.16personalities.com/istj-personality"
              target="_blank"
              rel="noopener noreferer"
            >
              Logistician (ISTJ)</a
            >, which honestly feels pretty accurate.
          </p>
        </div>
        <div
          class="flex items-center justify-center bg-muted-background/50 lg:border-l border-border p-6"
        >
          <span class="text-8xl" role="img" aria-label="brain">🧠</span>
        </div>
      </div>
    </div>
  </BorderedContainedSection>

  <BorderedContainedSection>
    <h2 class="mb-3">Discover</h2>
    <ul class="flex flex-col gap-3">
      <li><h4 class="">Projects</h4></li>
      <li><h4 class=""><a href="/photos">Photography</a></h4></li>
      <li><h4 class=""><a href="/experiments">Lab/ Experiments</a></h4></li>
      <li><h4 class="">Spoon Carving</h4></li>
    </ul>
  </BorderedContainedSection>
  <BorderedContainedSection>
    <h2>Socials</h2>
    <div class="flex gap-2">
      <SocialLinks />
    </div>
    <p class="text-center mt-3">Made with ❤️ by me!</p>
  </BorderedContainedSection>
</main>
