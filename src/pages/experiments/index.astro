---
import Layout from '@layouts/Layout.astro';
import BorderedContainedSection from '@components/_shared/BorderedContainedSection.astro';
import MobileNav from '@components/MobileNav';

const pages: { url: string }[] = Object.values(import.meta.glob('./*.astro', { eager: true }));
---

<Layout>
  <main class="w-full min-h-full flex flex-col items-center">
    <BorderedContainedSection condensed>
      <div class="flex flex-row justify-between">
        <a
          href="/"
          class="flex flex-col items-start justify-center max-sm:opacity-0 group no-underline"
          aria-label="Return to homepage"
        >
          <span>Home</span>
        </a>
        <MobileNav client:load />
      </div>
    </BorderedContainedSection>
    <BorderedContainedSection>
      <h1>Experiments</h1>
    </BorderedContainedSection>
    <BorderedContainedSection>
      <ul>
        {
          pages.map((page) => {
            const labelFromUrl = page.url.replace('/experiments/', '');
            return (
              <li>
                <a href={page.url}>
                  <h2>{labelFromUrl}</h2>
                </a>
              </li>
            );
          })
        }
      </ul>
    </BorderedContainedSection>
  </main>
</Layout>
