---
import ProjectSelector from './ProjectSelector.svelte';

// This component must be rendered as a server island to ensure Referer header is available
const referer = Astro.request.headers.get('Referer')!;
const url = new URL(referer);

const allProjects = Astro.props.allProjects || [];
const selectedProjectSlug = url.searchParams.get('project') || allProjects[0]?.slug || '';
---

<ProjectSelector client:load allProjects={allProjects} initialProjectSlug={selectedProjectSlug} />
