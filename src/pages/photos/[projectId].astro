---
import Layout from '@layouts/Layout.astro';
import Header from '@components/_shared/Header.astro';
import HeaderBackdrop from '@components/_shared/HeaderBackdrop.astro';

import { GET } from '../../pages/api/behance/all-graphql';
import type { SanitisedBehancePhotographyProject } from '@@types/behance';

export const prerender = true;
export async function getStaticPaths() {
  const allProjectsResponse = await GET(Astro);
  const allProjects: SanitisedBehancePhotographyProject[] = await allProjectsResponse.json();
  return allProjects.map((project) => ({
    params: { projectId: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<Layout title={project.name}>
  <main class="w-full min-h-dvh flex flex-col items-center text-muted-foreground photos-detail-bg">
    <Header>
      <a href="/photos">
        <h2>Back to albums</h2>
      </a>
    </Header>
    <HeaderBackdrop class="photos-detail-header-backdrop opacity-80" />
    <svg
      class="corner-shadow"
      viewBox="0 0 500 500"
      preserveAspectRatio="xMaxYMin slice"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <filter id="leaf-blur" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="2.5" />
        </filter>
      </defs>
      <g fill="#36100c" stroke="#36100c" stroke-linecap="round" opacity="0.35" filter="url(#leaf-blur)">
        {/* Main branch */}
        <path d="M 520 -20 C 470 50, 420 80, 370 130 S 250 230, 170 320" stroke-width="5" fill="none" />
        {/* Secondary branches */}
        <path d="M 430 50 C 400 110, 340 140, 280 160" stroke-width="3" fill="none" />
        <path d="M 360 140 C 320 190, 270 215, 230 270" stroke-width="2.5" fill="none" />
        <path d="M 280 160 C 260 200, 225 230, 190 250" stroke-width="2" fill="none" />
        {/* Leaves */}
        <ellipse cx="480" cy="25" rx="18" ry="7" transform="rotate(-35 480 25)" />
        <ellipse cx="450" cy="55" rx="20" ry="8" transform="rotate(-10 450 55)" />
        <ellipse cx="435" cy="95" rx="16" ry="6" transform="rotate(-60 435 95)" />
        <ellipse cx="410" cy="75" rx="22" ry="8" transform="rotate(25 410 75)" />
        <ellipse cx="395" cy="120" rx="18" ry="7" transform="rotate(-25 395 120)" />
        <ellipse cx="360" cy="100" rx="16" ry="6" transform="rotate(55 360 100)" />
        <ellipse cx="345" cy="155" rx="20" ry="8" transform="rotate(-15 345 155)" />
        <ellipse cx="315" cy="185" rx="18" ry="7" transform="rotate(40 315 185)" />
        <ellipse cx="285" cy="175" rx="16" ry="6" transform="rotate(-30 285 175)" />
        <ellipse cx="270" cy="220" rx="20" ry="8" transform="rotate(15 270 220)" />
        <ellipse cx="240" cy="255" rx="18" ry="7" transform="rotate(-20 240 255)" />
        <ellipse cx="215" cy="295" rx="16" ry="6" transform="rotate(50 215 295)" />
        <ellipse cx="190" cy="320" rx="14" ry="5" transform="rotate(-10 190 320)" />
        <ellipse cx="175" cy="275" rx="15" ry="6" transform="rotate(30 175 275)" />
        <ellipse cx="255" cy="130" rx="14" ry="5" transform="rotate(70 255 130)" />
        <ellipse cx="300" cy="65" rx="15" ry="6" transform="rotate(-45 300 65)" />
      </g>
    </svg>

    <section class="photo-grid-section">
      <div class="photo-grid">
        {project.imageSizes.map((img, i) => {
          const fallback = img.size_disp ?? img.size_max_1200 ?? img.size_1400_opt_1 ?? img.size_fs ?? img.size_2800_opt_1;
          if (!fallback) return null;

          const full = img.size_fs ?? img.size_2800_opt_1 ?? img.size_1400_opt_1 ?? img.size_max_1200 ?? fallback;
          const srcsetParts = [
            img.size_disp && `${img.size_disp.url} ${img.size_disp.width}w`,
            img.size_max_1200 && `${img.size_max_1200.url} ${img.size_max_1200.width}w`,
            img.size_1400_opt_1 && `${img.size_1400_opt_1.url} ${img.size_1400_opt_1.width}w`,
          ].filter(Boolean).join(', ');

          return (
            <button
              class="photo-item"
              data-index={i}
              data-full={full.url}
            >
              <img
                src={fallback.url}
                srcset={srcsetParts || undefined}
                sizes={srcsetParts ? "(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 300px" : undefined}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </button>
          );
        })}
      </div>
    </section>
  </main>

  <div id="lightbox" class="lightbox" hidden>
    <canvas id="lightbox-canvas"></canvas>
    <div id="lightbox-loading" class="lightbox-status">Loading...</div>
    <div id="lightbox-error" class="lightbox-status" hidden>Failed to load image</div>
    <button id="lightbox-close" aria-label="Close lightbox">&times;</button>
  </div>
</Layout>

<style>
  .photos-detail-bg {
    background-color: oklch(0.91 0.05 66.28 / 1);
  }

  .photos-detail-header-backdrop {
    background-image: linear-gradient(to bottom, oklch(0.91 0.05 66.28 / 1), transparent);
  }

  .photo-grid-section {
    width: 100%;
    max-width: 72rem;
    padding: 8rem 1.5rem 3rem;
    margin: 0 auto;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .photo-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .photo-grid-section {
      padding: 8rem 1rem 2rem;
    }
  }

  @media (min-width: 1024px) {
    .photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .photo-item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    background: transparent;
    display: block;
    width: 100%;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .photo-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Corner branch & leaf shadow overlay */
  .corner-shadow {
    position: fixed;
    top: 0;
    right: 0;
    width: 50vw;
    height: 50vw;
    max-width: 600px;
    max-height: 600px;
    pointer-events: none;
    z-index: 50;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox[hidden] {
    display: none;
  }

  #lightbox-canvas {
    display: block;
    touch-action: none;
    cursor: default;
  }

  .lightbox-status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1rem;
    pointer-events: none;
  }

  #lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const lightbox = document.getElementById('lightbox') as HTMLDivElement;
    const canvas = document.getElementById('lightbox-canvas') as HTMLCanvasElement;
    const loadingEl = document.getElementById('lightbox-loading') as HTMLDivElement;
    const errorEl = document.getElementById('lightbox-error') as HTMLDivElement;
    const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement;

    if (!lightbox || !canvas || !loadingEl || !errorEl || !closeBtn) return;

    const ctx = canvas.getContext('2d')!;

    const state = {
      img: null as HTMLImageElement | null,
      scale: 1,
      baseScale: 1,
      cx: 0,
      cy: 0,
      isDragging: false,
      dragStartX: 0,
      dragStartY: 0,
      dragStartCx: 0,
      dragStartCy: 0,
      hasDragged: false,
      lastPinchDist: 0,
      lastTapTime: 0,
    };

    let prevOverflow = '';

    function draw() {
      if (!state.img) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const w = state.img.naturalWidth * state.scale;
      const h = state.img.naturalHeight * state.scale;
      ctx.drawImage(state.img, state.cx - w / 2, state.cy - h / 2, w, h);
    }

    function resetView() {
      if (!state.img) return;
      const padding = 0.9;
      const scaleX = canvas.width / state.img.naturalWidth;
      const scaleY = canvas.height / state.img.naturalHeight;
      state.baseScale = Math.min(scaleX, scaleY) * padding;
      state.scale = state.baseScale;
      state.cx = canvas.width / 2;
      state.cy = canvas.height / 2;
    }

    function sizeCanvas() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = window.innerWidth + 'px';
      canvas.style.height = window.innerHeight + 'px';
      if (state.img) {
        resetView();
        draw();
      }
    }

    function openLightbox(src: string) {
      prevOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';

      state.img = null;
      loadingEl.hidden = false;
      errorEl.hidden = true;
      lightbox.hidden = false;

      sizeCanvas();

      const img = new Image();
      img.onload = () => {
        state.img = img;
        loadingEl.hidden = true;
        resetView();
        draw();
      };
      img.onerror = () => {
        loadingEl.hidden = true;
        errorEl.hidden = false;
      };
      img.src = src;
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = prevOverflow;
      state.img = null;
    }

    // Grid click handler
    document.querySelectorAll<HTMLButtonElement>('.photo-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.dataset.full;
        if (src) openLightbox(src);
      });
    });

    // Close handlers
    closeBtn.addEventListener('click', closeLightbox);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
    window.addEventListener('resize', () => {
      if (!lightbox.hidden) sizeCanvas();
    });

    // Wheel zoom
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (!state.img) return;

      const dpr = window.devicePixelRatio || 1;
      const factor = e.deltaY < 0 ? 1.1 : 1 / 1.1;
      const newScale = Math.max(state.baseScale, Math.min(state.baseScale * 10, state.scale * factor));

      const mx = e.clientX * dpr;
      const my = e.clientY * dpr;
      state.cx = mx - (mx - state.cx) * newScale / state.scale;
      state.cy = my - (my - state.cy) * newScale / state.scale;
      state.scale = newScale;

      draw();
    }, { passive: false });

    // Mouse drag
    canvas.addEventListener('mousedown', (e) => {
      state.isDragging = true;
      state.hasDragged = false;
      const dpr = window.devicePixelRatio || 1;
      state.dragStartX = e.clientX * dpr;
      state.dragStartY = e.clientY * dpr;
      state.dragStartCx = state.cx;
      state.dragStartCy = state.cy;
      canvas.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!state.isDragging) return;
      const dpr = window.devicePixelRatio || 1;
      const dx = e.clientX * dpr - state.dragStartX;
      const dy = e.clientY * dpr - state.dragStartY;
      if (Math.abs(dx) > 3 * dpr || Math.abs(dy) > 3 * dpr) state.hasDragged = true;
      state.cx = state.dragStartCx + dx;
      state.cy = state.dragStartCy + dy;
      draw();
    });

    window.addEventListener('mouseup', () => {
      state.isDragging = false;
      canvas.style.cursor = state.scale > state.baseScale * 1.05 ? 'grab' : 'default';
    });

    // Double-click zoom toggle
    canvas.addEventListener('dblclick', (e) => {
      if (!state.img) return;
      const dpr = window.devicePixelRatio || 1;

      if (state.scale > state.baseScale * 1.05) {
        resetView();
      } else {
        const mx = e.clientX * dpr;
        const my = e.clientY * dpr;
        const newScale = state.baseScale * 2.5;
        state.cx = mx - (mx - state.cx) * newScale / state.scale;
        state.cy = my - (my - state.cy) * newScale / state.scale;
        state.scale = newScale;
      }
      draw();
    });

    // Touch: pinch-to-zoom, drag, double-tap
    const dist = (a: Touch, b: Touch) => Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
    const center = (a: Touch, b: Touch) => {
      const dpr = window.devicePixelRatio || 1;
      return { x: ((a.clientX + b.clientX) / 2) * dpr, y: ((a.clientY + b.clientY) / 2) * dpr };
    };

    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      const dpr = window.devicePixelRatio || 1;

      if (e.touches.length === 1) {
        const now = Date.now();
        if (now - state.lastTapTime < 300) {
          if (state.scale > state.baseScale * 1.05) {
            resetView();
          } else {
            const mx = e.touches[0].clientX * dpr;
            const my = e.touches[0].clientY * dpr;
            const newScale = state.baseScale * 2.5;
            state.cx = mx - (mx - state.cx) * newScale / state.scale;
            state.cy = my - (my - state.cy) * newScale / state.scale;
            state.scale = newScale;
          }
          draw();
          state.lastTapTime = 0;
          return;
        }
        state.lastTapTime = now;
        state.isDragging = true;
        state.hasDragged = false;
        state.dragStartX = e.touches[0].clientX * dpr;
        state.dragStartY = e.touches[0].clientY * dpr;
        state.dragStartCx = state.cx;
        state.dragStartCy = state.cy;
      } else if (e.touches.length === 2) {
        state.isDragging = false;
        state.lastPinchDist = dist(e.touches[0], e.touches[1]);
      }
    }, { passive: false });

    canvas.addEventListener('touchmove', (e) => {
      e.preventDefault();
      const dpr = window.devicePixelRatio || 1;

      if (e.touches.length === 1 && state.isDragging) {
        const dx = e.touches[0].clientX * dpr - state.dragStartX;
        const dy = e.touches[0].clientY * dpr - state.dragStartY;
        if (Math.abs(dx) > 3 * dpr || Math.abs(dy) > 3 * dpr) state.hasDragged = true;
        state.cx = state.dragStartCx + dx;
        state.cy = state.dragStartCy + dy;
        draw();
      } else if (e.touches.length === 2) {
        const d = dist(e.touches[0], e.touches[1]);
        const c = center(e.touches[0], e.touches[1]);

        if (state.lastPinchDist > 0) {
          const factor = d / state.lastPinchDist;
          const newScale = Math.max(state.baseScale, Math.min(state.baseScale * 10, state.scale * factor));
          state.cx = c.x - (c.x - state.cx) * newScale / state.scale;
          state.cy = c.y - (c.y - state.cy) * newScale / state.scale;
          state.scale = newScale;
        }
        state.lastPinchDist = d;
        draw();
      }
    }, { passive: false });

    canvas.addEventListener('touchend', (e) => {
      if (e.touches.length === 0) {
        state.isDragging = false;
        state.lastPinchDist = 0;
      } else if (e.touches.length === 1) {
        const dpr = window.devicePixelRatio || 1;
        state.isDragging = true;
        state.hasDragged = true;
        state.dragStartX = e.touches[0].clientX * dpr;
        state.dragStartY = e.touches[0].clientY * dpr;
        state.dragStartCx = state.cx;
        state.dragStartCy = state.cy;
        state.lastPinchDist = 0;
      }
    });
  });
</script>
